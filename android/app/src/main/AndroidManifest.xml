<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- INTERNET (sign-in and sync, optional) and the password-reset link
         are in src/full/AndroidManifest.xml: the Offline edition has
         neither. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC"/>

    <!-- Alarms. USE_EXACT_ALARM is the permission for alarm clocks: given
         at install, never asked, never switched off. Android 12 has only
         the older SCHEDULE_EXACT_ALARM. -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM"/>
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" android:maxSdkVersion="32"/>
    <!-- Set every alarm again after a restart, before the first unlock too. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <!-- The ringing alarm's notification and its screen over the lock screen. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT"/>
    <!-- Android 16: a running timer or the stopwatch counts in a live chip
         in the status bar. Given at install; the user can switch it off. -->
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS"/>
    <!-- The service that rings. "System exempted" is the type Android
         keeps for apps continuing an exact alarm. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SYSTEM_EXEMPTED"/>
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <!-- Bedtime: Do Not Disturb through the night, only after the user
         gives the app Do Not Disturb access in Android's settings. -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY"/>
    <!-- Sleep sounds play on with the screen off. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"/>
    <uses-permission android:name="android.permission.VIBRATE"/>
    <!-- The "scan a code" wake-up task: asked for only when that task is
         picked. Frames are read on the phone and never kept. A phone
         without a camera can still install the app. -->
    <uses-permission android:name="android.permission.CAMERA"/>
    <!-- Bedtime's "Save sleep to Health Connect" (Android 14 and later,
         off unless switched on, asked for then). Write only: the app never
         reads health data. -->
    <uses-permission android:name="android.permission.health.WRITE_SLEEP"/>
    <uses-feature android:name="android.hardware.camera" android:required="false"/>
    <uses-feature android:name="android.hardware.camera.any" android:required="false"/>
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false"/>
    <uses-feature android:name="android.hardware.camera.flash" android:required="false"/>

    <application
        android:supportsRtl="true"
        android:label="ZT Clock"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Long-press shortcuts: new alarm, new timer, start stopwatch. -->
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts"/>
            <!-- Links are handled by the app's own code (app_links, see
                 lib/app/email_links.dart), not Flutter's router. -->
            <meta-data android:name="flutter_deeplinking_enabled" android:value="false"/>
        </activity>

        <!-- The alarm engine (dev.sagron.zerotrustclock.engine). Every part
             is directBootAware: it runs before the phone's first unlock
             after a restart, which is when a GrapheneOS phone that
             restarted itself overnight has to ring. None is exported. -->
        <activity
            android:name=".engine.RingActivity"
            android:exported="false"
            android:directBootAware="true"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:taskAffinity=""
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/RingTheme"/>
        <!-- The sunrise before the bedtime's wake-up alarm, over the lock
             screen. -->
        <activity
            android:name=".engine.SunriseActivity"
            android:exported="false"
            android:directBootAware="true"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:taskAffinity=""
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:screenOrientation="portrait"
            android:theme="@style/RingTheme"/>
        <!-- Health Connect (Android 14 and later) needs a screen that says
             what the app does with health data, or it refuses the
             permission. Opened from Health Connect's own screens. -->
        <activity
            android:name=".engine.HealthInfoActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@style/RingTheme"/>
        <activity-alias
            android:name=".engine.HealthPermissionUsage"
            android:exported="true"
            android:targetActivity=".engine.HealthInfoActivity"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE"/>
                <category android:name="android.intent.category.HEALTH_PERMISSIONS"/>
            </intent-filter>
        </activity-alias>
        <!-- The camera for the "scan a code" wake-up task: saving a code
             from the editor, and scanning it over the lock screen. -->
        <activity
            android:name=".engine.ScanActivity"
            android:exported="false"
            android:directBootAware="true"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:screenOrientation="portrait"
            android:theme="@style/RingTheme"/>
        <service
            android:name=".engine.RingService"
            android:exported="false"
            android:directBootAware="true"
            android:foregroundServiceType="systemExempted"/>
        <!-- Smart wake window: listens for movement in the last minutes
             before an alarm and rings it early. -->
        <service
            android:name=".engine.SmartWakeService"
            android:exported="false"
            android:directBootAware="true"
            android:foregroundServiceType="systemExempted"/>
        <!-- The day ahead, after an alarm is dismissed. -->
        <activity
            android:name=".engine.MorningActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:taskAffinity=""
            android:showWhenLocked="true"
            android:screenOrientation="portrait"
            android:theme="@style/RingTheme"/>
        <!-- Timers: "Time's up" over the lock screen, the service that
             rings finished timers, and the receiver for their ends and
             notification buttons. -->
        <activity
            android:name=".engine.TimerRingActivity"
            android:exported="false"
            android:directBootAware="true"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:taskAffinity=""
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:screenOrientation="portrait"
            android:theme="@style/RingTheme"/>
        <service
            android:name=".engine.TimerRingService"
            android:exported="false"
            android:directBootAware="true"
            android:foregroundServiceType="systemExempted"/>
        <receiver
            android:name=".engine.TimerReceiver"
            android:exported="false"
            android:directBootAware="true"/>
        <!-- Bedtime: the reminder, and the night's start and end. -->
        <receiver
            android:name=".engine.BedtimeReceiver"
            android:exported="false"
            android:directBootAware="true"/>
        <service
            android:name=".engine.SleepSoundService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback"/>
        <!-- Home screen widgets (engine/Widgets.kt), in the shared
             Zero-Trust widget look. -->
        <receiver
            android:name=".engine.ClockWidget"
            android:exported="false"
            android:label="@string/widget_clock_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/>
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_clock_info"/>
        </receiver>
        <receiver
            android:name=".engine.WorldClockWidget"
            android:exported="false"
            android:label="@string/widget_world_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/>
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_world_info"/>
        </receiver>
        <receiver
            android:name=".engine.AnalogClockWidget"
            android:exported="false"
            android:label="@string/widget_analog_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/>
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_analog_info"/>
        </receiver>
        <receiver
            android:name=".engine.TimerWidget"
            android:exported="false"
            android:label="@string/widget_timer_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/>
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_timer_info"/>
        </receiver>
        <receiver
            android:name=".engine.StopwatchWidget"
            android:exported="false"
            android:label="@string/widget_stopwatch_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/>
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_stopwatch_info"/>
        </receiver>
        <!-- Quick Settings tiles: the next alarm, the timer, and the stopwatch. -->
        <service
            android:name=".engine.ClockScreensaver"
            android:exported="true"
            android:directBootAware="true"
            android:icon="@drawable/ic_stat_alarm"
            android:label="@string/screensaver_name"
            android:permission="android.permission.BIND_DREAM_SERVICE">
            <intent-filter>
                <action android:name="android.service.dreams.DreamService"/>
                <category android:name="android.intent.category.DEFAULT"/>
            </intent-filter>
        </service>
        <service
            android:name=".engine.NextAlarmTile"
            android:exported="true"
            android:icon="@drawable/ic_stat_alarm"
            android:label="@string/tile_next_alarm"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE"/>
            </intent-filter>
        </service>
        <service
            android:name=".engine.TimerTile"
            android:exported="true"
            android:icon="@drawable/ic_stat_timer"
            android:label="@string/tile_timer"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE"/>
            </intent-filter>
        </service>
        <service
            android:name=".engine.StopwatchTile"
            android:exported="true"
            android:icon="@drawable/ic_stat_timer"
            android:label="@string/stopwatch"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE"/>
            </intent-filter>
        </service>
        <!-- "Set an alarm for 7" and "set a timer for 5 minutes" from
             assistants and other apps (Android's standard alarm intents).
             Callers need SET_ALARM. -->
        <activity
            android:name=".engine.SetAlarmActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:permission="com.android.alarm.permission.SET_ALARM"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.SET_ALARM"/>
                <action android:name="android.intent.action.SHOW_ALARMS"/>
                <action android:name="android.intent.action.SET_TIMER"/>
                <action android:name="android.intent.action.SHOW_TIMERS"/>
                <action android:name="android.intent.action.DISMISS_ALARM"/>
                <action android:name="android.intent.action.SNOOZE_ALARM"/>
                <action android:name="android.intent.action.DISMISS_TIMER"/>
                <category android:name="android.intent.category.DEFAULT"/>
            </intent-filter>
        </activity>
        <receiver
            android:name=".engine.AlarmReceiver"
            android:exported="false"
            android:directBootAware="true"/>
        <receiver
            android:name=".engine.BootReceiver"
            android:exported="false"
            android:directBootAware="true">
            <intent-filter>
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED"/>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
                <action android:name="android.intent.action.TIME_SET"/>
                <action android:name="android.intent.action.TIMEZONE_CHANGED"/>
                <!-- Android 12: taking "Alarms & reminders" away cancels
                     every alarm. Set them again when it is given back. -->
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED"/>
            </intent-filter>
        </receiver>

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="https"/>
        </intent>
        <!-- The morning screen opens these apps when they are installed. -->
        <package android:name="dev.sagron.zerotrustcalendar"/>
        <package android:name="dev.sagron.zerotrusttasks"/>
        <package android:name="dev.sagron.zerotrustquests"/>
    </queries>
</manifest>
