<?xml version="1.0" encoding="utf-8"?>
<!-- Stopwatch widget: the stopwatch, counting, with Start or Pause and
     Lap or Reset. Zero-Trust widget kit look. Also the picker's preview. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    style="@style/ZtWidget.Root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/widget_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="32dp"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="@dimen/zt_widget_header_icon"
            android:layout_height="@dimen/zt_widget_header_icon"
            android:importantForAccessibility="no"
            android:src="@mipmap/ic_launcher" />

        <TextView
            android:id="@+id/widget_stopwatch_title"
            style="@style/ZtWidget.AppName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="@string/widget_stopwatch_title" />
    </LinearLayout>

    <!-- Counts by itself while running; Android keeps it current. -->
    <Chronometer
        android:id="@+id/widget_stopwatch_chrono"
        style="@style/ZtWidget.Display"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:autoSizeMaxTextSize="40sp"
        android:autoSizeMinTextSize="18sp"
        android:autoSizeTextType="uniform"
        android:gravity="start|center_vertical"
        android:includeFontPadding="false"
        android:textAlignment="viewStart"
        android:textDirection="ltr"
        android:visibility="gone" />

    <!-- The same place when it stands still: paused, set, or "Time's up". -->
    <TextView
        android:id="@+id/widget_stopwatch_text"
        style="@style/ZtWidget.Display"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:autoSizeMaxTextSize="40sp"
        android:autoSizeMinTextSize="18sp"
        android:autoSizeTextType="uniform"
        android:gravity="start|center_vertical"
        android:includeFontPadding="false"
        android:text="@string/widget_sample_stopwatch" />

    <TextView
        android:id="@+id/widget_stopwatch_caption"
        style="@style/ZtWidget.Caption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/timer_running" />

    <LinearLayout
        android:id="@+id/widget_stopwatch_buttons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:minHeight="40dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_stopwatch_b1"
            style="@style/ZtWidget.Caption"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:background="@drawable/zt_widget_accent_pill"
            android:gravity="center"
            android:minWidth="56dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="@string/widget_start"
            android:textColor="@color/zt_widget_on_accent" />

        <TextView
            android:id="@+id/widget_stopwatch_b2"
            style="@style/ZtWidget.Caption"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/zt_widget_tile"
            android:gravity="center"
            android:minWidth="56dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="@string/stopwatch_lap_button"
            android:textColor="@color/zt_widget_on_surface" />
    </LinearLayout>
</LinearLayout>
