<?xml version="1.0" encoding="utf-8"?>
<!-- The ring screen, over the lock screen. Kept to plain views. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ring_background"
    android:fitsSystemWindows="true"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="32dp"
    android:paddingTop="32dp"
    android:paddingEnd="32dp"
    android:paddingBottom="40dp">

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="2" />

    <ImageView
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_stat_alarm"
        android:tint="@color/ring_text" />

    <TextClock
        android:id="@+id/ring_clock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:fontFamily="sans-serif-light"
        android:textColor="@color/ring_text"
        android:textSize="80sp" />

    <TextView
        android:id="@+id/ring_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="2"
        android:text="@string/ring_alarm"
        android:textColor="@color/ring_text_soft"
        android:textSize="22sp" />

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="3" />

    <Button
        android:id="@+id/ring_snooze"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:background="@drawable/ring_button_outline"
        android:stateListAnimator="@null"
        android:text="@string/ring_snooze"
        android:textAllCaps="false"
        android:textColor="@color/ring_text"
        android:textSize="22sp" />

    <dev.sagron.zerotrustclock.engine.SlideToDismiss
        android:id="@+id/ring_dismiss"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_marginTop="20dp" />
</LinearLayout>
