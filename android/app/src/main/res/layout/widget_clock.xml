<?xml version="1.0" encoding="utf-8"?>
<!-- Clock widget: the time, the date and the next alarm with Turn off once.
     Zero-Trust widget kit look. Also the picker's preview. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    style="@style/ZtWidget.Root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/widget_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="@dimen/zt_widget_header_icon"
            android:layout_height="@dimen/zt_widget_header_icon"
            android:importantForAccessibility="no"
            android:src="@mipmap/ic_launcher" />

        <TextView
            style="@style/ZtWidget.AppName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="@string/widget_app_name" />

        <ImageView
            android:id="@+id/widget_add"
            style="@style/ZtWidget.Action"
            android:contentDescription="@string/shortcut_new_alarm"
            android:src="@drawable/ic_zt_widget_add" />
    </LinearLayout>

    <TextClock
        android:id="@+id/widget_time"
        style="@style/ZtWidget.Display"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:format12Hour="h:mm"
        android:format24Hour="HH:mm"
        android:includeFontPadding="false"
        android:textSize="52sp" />

    <TextClock
        android:id="@+id/widget_date"
        style="@style/ZtWidget.Caption"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:format12Hour="EEEE, MMMM d"
        android:format24Hour="EEEE, MMMM d" />

    <LinearLayout
        android:id="@+id/widget_alarm_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:minHeight="40dp"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_stat_alarm"
            android:tint="@color/zt_widget_on_surface_variant" />

        <TextView
            android:id="@+id/widget_alarm_text"
            style="@style/ZtWidget.Body"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:text="@string/widget_sample_alarm" />

        <TextView
            android:id="@+id/widget_alarm_button"
            style="@style/ZtWidget.Caption"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:background="@drawable/zt_widget_accent_pill"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="@string/upcoming_turn_off_once"
            android:textColor="@color/zt_widget_on_accent" />
    </LinearLayout>
</LinearLayout>
