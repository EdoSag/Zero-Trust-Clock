<?xml version="1.0" encoding="utf-8"?>
<!-- The day ahead, after an alarm is dismissed (MorningActivity). Plain
     views in the ring screen's colours. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ring_background"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:paddingStart="28dp"
    android:paddingTop="32dp"
    android:paddingEnd="28dp"
    android:paddingBottom="32dp">

    <TextView
        android:id="@+id/morning_hello"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:fontFamily="sans-serif-light"
        android:text="@string/morning_hello"
        android:textColor="@color/ring_text"
        android:textSize="34sp" />

    <TextView
        android:id="@+id/morning_date"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/ring_text_soft"
        android:textSize="18sp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="24dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/morning_rows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <TextView
        android:id="@+id/morning_note"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:textColor="@color/ring_text_soft"
        android:textSize="13sp" />

    <Button
        android:id="@+id/morning_close"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@drawable/ring_button_outline"
        android:stateListAnimator="@null"
        android:text="@string/morning_close"
        android:textAllCaps="false"
        android:textColor="@color/ring_text"
        android:textSize="18sp" />
</LinearLayout>
