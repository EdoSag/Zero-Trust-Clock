<?xml version="1.0" encoding="utf-8"?>
<!-- What ZT Clock does with Health Connect (HealthInfoActivity). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF0B0F1A"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="32dp"
    android:paddingEnd="24dp"
    android:paddingBottom="24dp">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/health_title"
                android:textAlignment="viewStart"
                android:textColor="#FFFFFFFF"
                android:textSize="26sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:lineSpacingMultiplier="1.2"
                android:text="@string/health_text"
                android:textAlignment="viewStart"
                android:textColor="#FFD5D9E6"
                android:textSize="17sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:autoLink="web"
                android:text="@string/health_policy"
                android:textAlignment="viewStart"
                android:textColor="#FFD5D9E6"
                android:textColorLink="#FFA5B4FC"
                android:textSize="17sp" />
        </LinearLayout>
    </ScrollView>

    <Button
        android:id="@+id/health_close"
        android:layout_width="wrap_content"
        android:layout_height="56dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:background="@android:color/transparent"
        android:minWidth="160dp"
        android:stateListAnimator="@null"
        android:text="@string/sunrise_close"
        android:textAllCaps="false"
        android:textColor="#FFA5B4FC"
        android:textSize="18sp" />
</LinearLayout>
