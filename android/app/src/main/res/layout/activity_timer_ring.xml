<?xml version="1.0" encoding="utf-8"?>
<!-- "Time's up", over the lock screen. Kept to plain views. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ring_background"
    android:fitsSystemWindows="true"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="32dp"
    android:paddingTop="32dp"
    android:paddingEnd="32dp"
    android:paddingBottom="40dp">

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="2" />

    <ImageView
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_stat_timer"
        android:tint="@color/ring_text" />

    <TextView
        android:id="@+id/timer_ring_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:fontFamily="sans-serif-light"
        android:gravity="center"
        android:text="@string/timer_times_up"
        android:textColor="@color/ring_text"
        android:textSize="48sp" />

    <TextView
        android:id="@+id/timer_ring_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="3"
        android:textColor="@color/ring_text_soft"
        android:textSize="22sp" />

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="3" />

    <Button
        android:id="@+id/timer_ring_add"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:background="@drawable/ring_button_outline"
        android:stateListAnimator="@null"
        android:text="@string/timer_add_minute"
        android:textAllCaps="false"
        android:textColor="@color/ring_text"
        android:textSize="22sp" />

    <Button
        android:id="@+id/timer_ring_stop"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/ring_button_filled"
        android:stateListAnimator="@null"
        android:text="@string/timer_stop"
        android:textAllCaps="false"
        android:textColor="@color/ring_background"
        android:textSize="22sp" />
</LinearLayout>
