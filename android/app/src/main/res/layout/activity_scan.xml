<?xml version="1.0" encoding="utf-8"?>
<!-- The camera, to save or scan a wake-up code. Kept to plain views, so it
     also opens over the lock screen. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ring_background"
    android:fitsSystemWindows="true"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="24dp"
    android:paddingEnd="24dp"
    android:paddingBottom="32dp">

    <TextView
        android:id="@+id/scan_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:minLines="2"
        android:textColor="@color/ring_text"
        android:textSize="20sp" />

    <!-- The camera's picture, kept at its own shape inside this box. -->
    <FrameLayout
        android:id="@+id/scan_box"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:layout_weight="1">

        <TextureView
            android:id="@+id/scan_preview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/scan_cancel"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:background="@drawable/ring_button_outline"
            android:stateListAnimator="@null"
            android:text="@string/scan_back"
            android:textAllCaps="false"
            android:textColor="@color/ring_text"
            android:textSize="18sp" />

        <Button
            android:id="@+id/scan_light"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:background="@drawable/ring_button_outline"
            android:stateListAnimator="@null"
            android:text="@string/scan_light"
            android:textAllCaps="false"
            android:textColor="@color/ring_text"
            android:textSize="18sp"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
