<?xml version="1.0" encoding="utf-8"?>
<!-- World clock widget: up to four of the Clock tab's cities, each with a
     live time (TextClock in that time zone). Zero-Trust widget kit look. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    style="@style/ZtWidget.Root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/widget_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="32dp"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="@dimen/zt_widget_header_icon"
            android:layout_height="@dimen/zt_widget_header_icon"
            android:importantForAccessibility="no"
            android:src="@mipmap/ic_launcher" />

        <TextView
            style="@style/ZtWidget.AppName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="@string/widget_world_title" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_world_empty"
        style="@style/ZtWidget.Caption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:maxLines="3"
        android:text="@string/widget_world_empty"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/widget_city_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="40dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_city_name_1"
            style="@style/ZtWidget.Body"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/widget_sample_city" />

        <TextClock
            android:id="@+id/widget_city_time_1"
            style="@style/ZtWidget.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:format12Hour="h:mm a"
            android:format24Hour="HH:mm"
            android:textSize="20sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_city_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="40dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_city_name_2"
            style="@style/ZtWidget.Body"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/widget_sample_city" />

        <TextClock
            android:id="@+id/widget_city_time_2"
            style="@style/ZtWidget.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:format12Hour="h:mm a"
            android:format24Hour="HH:mm"
            android:textSize="20sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_city_3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="40dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_city_name_3"
            style="@style/ZtWidget.Body"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/widget_sample_city" />

        <TextClock
            android:id="@+id/widget_city_time_3"
            style="@style/ZtWidget.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:format12Hour="h:mm a"
            android:format24Hour="HH:mm"
            android:textSize="20sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_city_4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="40dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_city_name_4"
            style="@style/ZtWidget.Body"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/widget_sample_city" />

        <TextClock
            android:id="@+id/widget_city_time_4"
            style="@style/ZtWidget.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:format12Hour="h:mm a"
            android:format24Hour="HH:mm"
            android:textSize="20sp" />
    </LinearLayout>
</LinearLayout>
