<?xml version="1.0" encoding="utf-8"?>
<!-- The sunrise before the wake-up alarm, over the lock screen. Its
     colours are set as the sky gets lighter (SunriseActivity). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/sunrise_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF140602"
    android:fitsSystemWindows="true"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="32dp"
    android:paddingTop="32dp"
    android:paddingEnd="32dp"
    android:paddingBottom="40dp">

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="2" />

    <TextClock
        android:id="@+id/sunrise_clock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-light"
        android:textColor="#FFFFE9D0"
        android:textSize="80sp" />

    <TextView
        android:id="@+id/sunrise_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:textColor="#FFFFE9D0"
        android:textSize="22sp" />

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="3" />

    <Button
        android:id="@+id/sunrise_close"
        android:layout_width="wrap_content"
        android:layout_height="56dp"
        android:background="@android:color/transparent"
        android:minWidth="160dp"
        android:stateListAnimator="@null"
        android:text="@string/sunrise_close"
        android:textAllCaps="false"
        android:textColor="#FFFFE9D0"
        android:textSize="18sp" />
</LinearLayout>
